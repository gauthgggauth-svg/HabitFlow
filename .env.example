# ---------------------------------------------------------------------------
# HabitFlow environment
# Salin ke `.env.local` lalu isi nilai sebenarnya. Jangan commit `.env.local`.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Midtrans (sandbox: https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_SCRIPT_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Scheduler: kirim header `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=generate-a-long-random-secret

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email opsional (Resend). Jika kosong, fitur email nonaktif.
RESEND_API_KEY=
EMAIL_FROM=HabitFlow <no-reply@example.com>
